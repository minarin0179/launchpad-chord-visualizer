{
  "name": "launchpad-chord-visualizer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "npm run build -w packages/launchpad-x",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts \"*.{ts,js,json}\"",
    "format:check": "prettier --check src tests scripts \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "smplr": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
